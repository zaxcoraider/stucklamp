# Claude through the DGrid gateway (not secret). Delete this file to call Anthropic directly.
# The key itself goes in .env as ANTHROPIC_API_KEY=... (sent to DGrid as a Bearer token).
ANTHROPIC_BASE_URL=https://api.dgrid.ai
# DGrid's model name; leave as is unless DGrid lists Claude Opus 5.5 under another name.
CLAUDE_MODEL=claude-opus-5-5
