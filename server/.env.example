# Copy to .env and fill in. Never commit .env.

# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord developer portal -> General Information -> Application ID
DISCORD_APP_ID=
# Anthropic key (console.anthropic.com), or a gateway key if you use .env.gateway
ANTHROPIC_API_KEY=

# Optional
# PORT=8787
# ROOM=demo
# MIN_CLUSTER=2          # how many students must share a problem before Claude groups them
# CLASS_CHANNEL_ID=      # channel for fixes when every student in a group joined from the web

# Optional: Telegram bot from @BotFather (/setprivacy -> Disable so it can read /stuck in groups)
TELEGRAM_BOT_TOKEN=
